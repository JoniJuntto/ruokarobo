{
  // Everything that runs outside a browser: the server and the headless tests (Bun) and the Vite config. No DOM
  // types here either, so the test also proves the mirror (src/client/mirror.ts) needs no browser.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": ["bun"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true
  },
  "include": ["server", "test", "vite.config.ts"]
}
