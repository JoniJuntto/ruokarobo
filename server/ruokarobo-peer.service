[Unit]
Description=Ruokarobo multiplayer signaling (PeerJS)
After=network.target

[Service]
ExecStart=/usr/bin/node /opt/ruokarobo-peer/peer.js
Restart=always
RestartSec=2
# DynamicUser gives the service its own throwaway account with nowhere to write, so a bug
# in it cannot reach the rest of the box.
DynamicUser=yes
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
